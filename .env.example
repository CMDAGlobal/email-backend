NODE_ENV=development
PORT=3000
# Dispatch owns this MongoDB database. Use a replica set because consent changes use transactions.
MONGODB_URI=mongodb://localhost:27017/dispatch?replicaSet=rs0
MONGODB_DATABASE=dispatch
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000
API_KEY=replace-with-at-least-32-random-characters
UNSUBSCRIBE_SECRET=replace-with-a-different-32-character-secret
SEND_MODE=dry-run
SEND_RATE_PER_SECOND=5
AWS_REGION=eu-west-1
SES_FROM_EMAIL=hello@example.com
SES_CONFIGURATION_SET=
# Optional SES -> SNS -> SQS event destination. Queue policy must restrict SNS source ARN.
SES_EVENTS_QUEUE_URL=
# AWS credentials use the SDK default chain; prefer an IAM role in production.

# CMDA stays in its own MongoDB cluster. Dispatch reads member data only through signed bridge requests.
CMDA_ENABLED=false
CMDA_SYNC_SECRET=
CMDA_FEEDBACK_SECRET=
CMDA_FEEDBACK_URL=
CMDA_MAX_SYNC_AGE_HOURS=24
