NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://dispatch:dispatch@localhost:5432/dispatch
REDIS_URL=redis://localhost:6379
FRONTEND_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:3000
API_KEY=replace-with-at-least-32-random-characters
UNSUBSCRIBE_SECRET=replace-with-a-different-32-character-secret
SEND_MODE=dry-run
SEND_RATE_PER_SECOND=5
AWS_REGION=eu-west-1
SES_FROM_EMAIL=hello@example.com
SES_CONFIGURATION_SET=
# Optional SES -> SNS -> SQS event destination. Queue policy must restrict SNS source ARN.
SES_EVENTS_QUEUE_URL=
# Credentials use the AWS SDK default chain (prefer a server IAM role).

# CMDA marketing connector (disabled until both servers are configured)
CMDA_ENABLED=false
# Must match CMDA DISPATCH_SYNC_SECRET; use a unique random value, 32+ characters.
CMDA_SYNC_SECRET=
# A different random value matching CMDA DISPATCH_FEEDBACK_SECRET.
CMDA_FEEDBACK_SECRET=
# Example: https://cmda-api.example.com/integrations/dispatch/feedback
CMDA_FEEDBACK_URL=
CMDA_MAX_SYNC_AGE_HOURS=24
